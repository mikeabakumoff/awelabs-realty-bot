# Copy to .env and fill in. Never commit the filled file.

# Telegram bot token from @BotFather
REALTY_BOT_TOKEN=

# OpenAI API key — used by both the conversation and the nightly learning pass
OPENAI_API_KEY=

# Numeric Telegram chat id that receives lead and visitor notifications
REALTY_OWNER_CHAT_ID=

# Google Sheet id holding the listings table
REALTY_SHEET_ID=